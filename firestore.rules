rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Product catalog: readable by all, writable only by admin
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Only admin SDK or console
    }

    // Categories: readable by all, writable only by admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // User cart: users can only read and write their own cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: users can only read their own orders
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.resource.data.items is list && request.resource.data.payment is map;
      allow update, delete: if false; // Immutability of placed orders
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
